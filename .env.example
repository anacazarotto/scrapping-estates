# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).

# Nome do arquivo SQLite usado pelos scrapers
IMOVEIS_DB=imoveis.db

# Tokens públicos usados pelos sites das imobiliárias nas próprias requisições.
# Obtenha-os no DevTools do navegador (aba Network) ao abrir o site de cada imobiliária.
MARKIZE_API_TOKEN=
PADRA_API_TOKEN=
SANTAMARIA_API_TOKEN=
